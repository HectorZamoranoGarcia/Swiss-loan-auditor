{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run Database Audit",
            "request": "launch",
            "mainClass": "backend.AppLauncher",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "classpath": [
                "${workspaceFolder}/bin",
                "${workspaceFolder}/lib/*"
            ],
            "vmArgs": "--module-path \"${env:JAVAFX_HOME}/lib\" --add-modules javafx.controls,javafx.fxml"
        }
    ]
}
